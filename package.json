{
  "name": "dsh-screenshot",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Region screenshot for the DeepSeek Harness composer: the host takes one desktop snapshot, and the screenshot is cropped, resized and annotated in a browser overlay before it lands in the composer as a pending attachment.",
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "screenshot",
    "capture",
    "annotation",
    "windows"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "scripts/*",
    "locale/*.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dcmwfg/dsh-screenshot.git"
  },
  "homepage": "https://github.com/Dcmwfg/dsh-screenshot#readme",
  "bugs": {
    "url": "https://github.com/Dcmwfg/dsh-screenshot/issues"
  }
}
